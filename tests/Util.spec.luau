local Loader = require("./lib/Loader")
local TestKit = require("./lib/TestKit")
local describe, it, expect = TestKit.describe, TestKit.it, TestKit.expect

local RateLimiter = Loader.shared("Util/RateLimiter")
local TableUtil = Loader.shared("Util/TableUtil")

describe("RateLimiter", function()
	it("allows a burst then throttles", function()
		local limiter = RateLimiter.new(2, 3)
		expect(limiter:check("p", 0)).toBe(true)
		expect(limiter:check("p", 0)).toBe(true)
		expect(limiter:check("p", 0)).toBe(true)
		expect(limiter:check("p", 0)).toBe(false)
	end)

	it("refills over time and tracks keys separately", function()
		local limiter = RateLimiter.new(2, 1)
		expect(limiter:check("a", 0)).toBe(true)
		expect(limiter:check("a", 0.1)).toBe(false)
		expect(limiter:check("b", 0.1)).toBe(true)
		expect(limiter:check("a", 0.6)).toBe(true)
	end)

	it("forgets keys", function()
		local limiter = RateLimiter.new(1, 1)
		limiter:check("a", 0)
		limiter:forget("a")
		expect(limiter:check("a", 0)).toBe(true)
	end)
end)

describe("TableUtil", function()
	it("deep copies", function()
		local original = { a = { b = 1 } }
		local copy = TableUtil.deepCopy(original)
		copy.a.b = 2
		expect(original.a.b).toBe(1)
	end)

	it("reconciles missing and mistyped keys", function()
		local target = { money = 5, nested = { x = "bad" }, extra = true }
		TableUtil.reconcile(target, { money = 0, nested = { x = 1, y = 2 }, list = {} })
		expect(target.money).toBe(5)
		expect(target.nested.x).toBe(1)
		expect(target.nested.y).toBe(2)
		expect(target.extra).toBe(true)
		expect(type(target.list)).toBe("table")
	end)

	it("counts dictionary entries", function()
		expect(TableUtil.count({ a = 1, b = 2 })).toBe(2)
	end)
end)

local Validate = Loader.shared("Util/Validate")
local Signal = Loader.shared("Util/Signal")

describe("Validate", function()
	it("checks strings", function()
		expect(Validate.string("Coffee")).toBe(true)
		expect(Validate.string("")).toBe(false)
		expect(Validate.string(5)).toBe(false)
		expect(Validate.string(string.rep("a", 65))).toBe(false)
	end)

	it("checks integers", function()
		expect(Validate.integer(3, 0, 10)).toBe(true)
		expect(Validate.integer(3.5, 0, 10)).toBe(false)
		expect(Validate.integer(0 / 0, 0, 10)).toBe(false)
		expect(Validate.integer(math.huge, 0, 10)).toBe(false)
		expect(Validate.integer(-1, 0, 10)).toBe(false)
		expect(Validate.integer("3", 0, 10)).toBe(false)
	end)

	it("checks string arrays", function()
		expect(Validate.stringArray({ "a", "b" }, 3)).toBe(true)
		expect(Validate.stringArray({}, 3)).toBe(false)
		expect(Validate.stringArray({ "a", "b", "c", "d" }, 3)).toBe(false)
		expect(Validate.stringArray({ a = "x" }, 3)).toBe(false)
		expect(Validate.stringArray({ "a", 5 }, 3)).toBe(false)
		expect(Validate.stringArray("a", 3)).toBe(false)
	end)

	it("checks membership", function()
		expect(Validate.oneOf("Coffee", { Coffee = true })).toBe(true)
		expect(Validate.oneOf("Tea", { Coffee = true })).toBe(false)
		expect(Validate.oneOf(nil, { Coffee = true })).toBe(false)
	end)
end)

describe("Signal", function()
	it("fires handlers and disconnects", function()
		local signal = Signal.new()
		local total = 0
		local connection = signal:connect(function(n)
			total += n
		end)
		signal:fire(2)
		connection:disconnect()
		signal:fire(5)
		expect(total).toBe(2)
	end)
end)
